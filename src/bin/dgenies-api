class DataFile:

    def __init__(self, path: str, type: str=None):
        self.path = path
        self.type = "url" if re.search(r"^(https?|ftp)://", path) else "local"
        self.name = os.path.basename(path)

class Job(ABC):

    batch_id = None

    def __init__(self, config, args):
        self.config = config
        self.email: str = args.email if args.email else ""
        self.name: str = args.name if args.name else random_job_name(10)

    @abstractmethod
    def check(self):
        # check tool, etc
        pass

    @abstractmethod
    def to_json(self):
        pass

    @abstractmethod
    def get_file(self, filename: str) -> DataFile:
        pass


def random_job_name(length):
   letters = string.ascii_lowercase
   return ''.join(random.choice(letters) for i in range(length))


def print_res(func):
    def wrapper(*args, **kwargs):
        result = func(*args, **kwargs)
        print(result)
        return result
    return wrapper

class AlignJob(Job):

    type = 'align'
    nb = 1

    def __init__(self, config, args):
        super().__init__(config, args)
        self.target = DataFile(args.target)
        self.query = DataFile(args.query) if args.query else None
        self.tool: str = args.tool if args.tool else "minimap2"
        self.options: list[str] = args.options if args.options else []
        self.check()
        self.name_to_file: dict[str, DataFile] = {
            self.target.name: self.target,
        }
        if self.query:
            self.name_to_file[self.query.name]=self.query

    def check(self):
        # check tool, etc
        pass

    #@print_res
    def to_json(self):
        return {
            "batch_id" : self.name,
            "email": self.email,
            "nb_jobs": self.nb,
            "jobs": [{
                "align": "",
                "align_type": "local",
                "backup": "",
                "backup_type": "local",
                "job_id": self.name,
                "query": self.query.name if self.query else "",
                "query_type": self.query.type if self.query else "local",
                "target": self.target.name,
                "target_type": self.target.type,
                "tool": self.tool,
                "tool_options": self.options,
                "type": self.type
            }]
        }

    def get_file(self, filename: str):
        return self.name_to_file[filename]


class PlotJob(Job):

    type = 'plot'
    nb = 1

    def __init__(self, config, args):
        super().__init__(config, args)
        self.align = DataFile(args.align) if ('align' in args and args.align) else None
        self.target = DataFile(args.target) if ('target' in args and args.target) else None
        self.query = DataFile(args.query) if ('query' in args and args.query) else None
        self.backup = DataFile(args.backup) if ('backup' in args and args.backup) else None
        self.check()
        self.name_to_file: dict[str, DataFile] = dict()
        for attr in ["align", "target", "query", "backup"]:
            val:DataFile = getattr(self, attr)
            print(val)
            if val is not None:
                self.name_to_file[val.name] = val

    def check(self):
        # check tool, etc
        pass

    #@print_res
    def to_json(self):
        return {
            "batch_id" : self.name,
            "email": self.email,
            "nb_jobs": self.nb,
            "jobs": [{
                "align": self.align.name if self.align else "",
                "align_type": self.align.type if self.align else "local",
                "backup": self.backup.name if self.backup else "",
                "backup_type": self.backup.type if self.backup else "local",
                "job_id": self.name,
                "query": self.query.name if self.query else "",
                "query_type": self.query.type if self.query else "local",
                "target": self.target.name if self.target else "",
                "target_type": self.target.type if self.target else "local",
                "tool": "minimap2",
                "tool_options": [],
                "type": self.type
            }]
        }

    def get_file(self, filename: str):
        return self.name_to_file[filename]

class BatchJob(Job):

    type = 'batch'
    nb = 1

    def __init__(self, config, args):
        super().__init__(config, args)
        #with open(args.batch_file) as input_file:
        #    tree = BatchJob.get_parser().parse(input_file.read())
        #    print(tree.pretty())
        #    jobs = BatchJob.BatchFileToBatchJob(config).transform(tree)
        #    #print(jobs)

        with open(args.batch_file, 'r') as batch_file:
            tree = BatchJob.get_parser().parse(batch_file.read())
            self.jobs: list[Job] = self.BatchFileToBatchJob(config, self.email).transform(tree)
        self.nb = len(self.jobs)
        self.check()

    def check(self):
        pass

    def to_json(self):
        return {
            "batch_id": self.name,
            "email": self.email,
            "nb_jobs": self.nb,
            "jobs": [j.to_json()["jobs"][0] for j in self.jobs],
        }

    def get_file(self, filename: str) -> DataFile:
        pass

    @classmethod
    def get_parser(cls) -> Lark:
        return Lark(r"""
            value: VALUE
                 | DQUOTEDVALUE
                 | SQUOTEDVALUE
            values: value ("," value)*
            param: KEY "=" value
            params: OPTIONS "=" values
            job: (param|params) (SPACES (param|params))* SPACES?
            whitespaces: (NEWLINES | SPACES)*
            jobs: whitespaces job (SPACES? NEWLINES job)* whitespaces
            
            COMMENT: /#[^\n\r]*/
            VALUE: /[^#\s'",]+/
            DQUOTEDVALUE: /"[^"#\r\n]+"/
            SQUOTEDVALUE: /'[^'#\r\n]+'/
            KEY: /(type|align|query|target|backup|tool|name)/
            OPTIONS: /options/
            NEWLINES: /[\n\r]+/
            SPACES:  /[\t ]+/
            
            %import common.ESCAPED_STRING
            %ignore COMMENT
        """, start='jobs')

    class BatchFileToBatchJob(Transformer):

        def __init__(self, config,  email: str = ''):
            super().__init__()
            self.config = config
            self.email = email

        def jobs(self, items):
            res = [j for j in items if j]
            return res

        def job(self, items):
            params = dict()
            for element in items:
                if element:
                    k, v = element
                    params[k.value] = v
            if "type" in params:
                job_type = params.pop("type")
                if job_type == "align":
                    if "query" not in params:
                        params["query"] = None
                    return AlignJob(config = self.config, args = SimpleNamespace(email=self.email, **params))
                elif job_type == "plot":
                    return PlotJob(config = self.config, args = SimpleNamespace(email=self.email, **params))
                else:
                    raise ValueError("Unknown value for 'type'")
            raise ValueError("Missing key 'key'")

        def param(self, key_value):
            k, v = key_value
            return k, v

        def params(self, key_value):
            k, v = key_value
            return k, v

        def values(self, items):
            return list(items)

        def value(self, val: list[Token]):
            (val,) = val # take first element of list
            if val.type == 'VALUE':
                return val.value
            # remove quotes around value
            return val.value[1:-1]


        whitespaces = lambda self, _: None
        SPACES = lambda self, _: None
        NEWLINES = lambda self, _: None

def get_config():
    try:
        r = requests.get(CONFIG_URL)
        if r.status_code != 200:
            print("Server error")
            print(r)
            exit(1)
        print("Server available")
        return r.json()
    except ConnectionError:
        print("Connection error")
        exit(1)


def check_job():
    # Check if submitted jobs are compatibles with server configuration
    pass


def create_job(args):
    check_job()
    return ""

def register_job(job):
    r = requests.post(JOB_URL, json=job)
    if r.status_code != 200:
        print("Error submitting job")
        print(json.dumps(r.json(), indent=4))
        exit(1)
    res = r.json()
    if res["code"] != 0:
        raise BaseException(res["message"])
    print("Job register")
    return res["data"]

def ask_upload(session_id: str):
    r = requests.post(ASK_UPLOAD_URL, json={"session_id": session_id})
    if r.status_code != 200:
        print("Error ask-upload")
        print(json.dumps(r.json(), indent=4))
        exit(1)
    res = r.json()
    if res["code"] != 0:
        raise BaseException(res["message"])
    return res["data"]


def get_file(file: str):
    return file


def ping_upload(session_id: str):
    r = requests.post(f'{ENDPOINT}/ping-upload', json={"session_id": session_id})
    if r.status_code != 200:
        print("Error pinging upload")
        print(json.dumps(r.json(), indent=4))
        exit(1)
    print(f"ping : {r.json()['message']}")


def upload_file(session_id, filename, file):
    files = {'file': open(file, 'rb')}
    r = requests.post(UPLOAD_URL, files=files, data={"session_id": session_id})
    if r.status_code != 200:
        print("Error ask-upload")
        print(json.dumps(r.json(), indent=4))
        exit(1)
    res = r.json()
    if res["code"] != 0:
        raise BaseException(res["message"])
    return res["data"]

def get_status(jod_id: str):
    r = requests.get(f'{ENDPOINT}/status/{jod_id}')
    if r.status_code != 200:
        print("Error ask-upload")
        print(json.dumps(r.json(), indent=4))
        exit(1)
    res = r.json()
    if res["code"] != 0:
        raise BaseException(res["message"])
    return res["data"]

def submit(job: Job):
    print("Submit a job")
    try:
        data = register_job(job.to_json())
        session_id = data["session_id"]
        needed_files = data["needed_files"]
        if needed_files:
            # We need to upload file
            data["allowed"] = data["allowed_upload"]
            while not data["allowed"]:
                sleep(15)
            # upload allowed
            # ping upload in a thread every 15s
            ping = Timer(15.0, ping_upload, kwargs={"session_id": session_id})
            ping.start()
            # upload itself
            while needed_files:
                print(f'remaining files: {needed_files}')
                next_file = needed_files.pop(0)
                print(f'uploading {next_file}')
                data = upload_file(session_id, next_file, job.get_file(next_file).path)
                # distant_filename = data["file"] # TODO update filename in local file data structure
                needed_files = data["needed_files"]
            ping.cancel()
        # job validated
        return data["batch_id"], data["job_ids"]

    except ConnectionError:
        print("Connection error")
        exit(1)


def submit_job(job):
    print("Submit a job")
    try:
        data = register_job(job)
        session_id = data["session_id"]
        needed_files = data["needed_files"]
        if needed_files:
            # We need to upload file
            data["allowed"] = data["allowed_upload"]
            while not data["allowed"]:
                sleep(15)
            # upload allowed
            # ping upload in a thread every 15s
            ping = Timer(15.0, ping_upload, kwargs={"session_id": session_id})
            ping.start()
            # upload itself
            while needed_files:
                next_file = needed_files.pop(0)
                data = upload_file(session_id, next_file, next_file)
                # distant_filename = data["file"] # TODO update filename in local file data structure
                needed_files = data["needed_files"]
            ping.cancel()
        # job validated
        return data["batch_id"], data["job_ids"]

    except ConnectionError:
        print("Connection error")
        exit(1)

def update_status(batch_id: str):
    status = get_status(batch_id)
    print(status)
    while status["percent"] < 100:
        sleep(30)
        status = get_status(batch_id)
        print(status)


def get_argparse() -> argparse.ArgumentParser :

    # TODO:
    # - if no config file exists, get it from default url.
    # - when config file exists, use it to populate options.
    # - display a warning and invite to run update command if config file is too "old" (old = 1 week ?)

    parser = argparse.ArgumentParser(description='Submit job to a D-Genies instance')
    subparsers = parser.add_subparsers(help='subcommand help', dest='command')

    parser_config = subparsers.add_parser('config', help='config help')
    parser_config.add_argument('action', choices=["update"], default="update", help='Action on config')
    parser_config.add_argument('--url', type=str, default=ENDPOINT, help='Use alternative url')

    parser_align = subparsers.add_parser('align', help='align help')
    parser_align.add_argument('--name', type=str, help='Preferred job name', required=False)
    parser_align.add_argument('--email', type=str, help='Email for notification', required=False)
    parser_align.add_argument('--target', type=str, help='Target (or reference) fasta file', required=True)
    parser_align.add_argument('--query', type=str, help='Query file fasta file', required=False)
    parser_align.add_argument('--tool', type=str, help='Tool used for alignment', required=False)
    parser_align.add_argument('--options', type=str, nargs='*', help='Options used with tool', required=False, default = [])

    parser_plot = subparsers.add_parser('plot', help='plot help')
    parser_plot.add_argument('--name', type=str, help='Preferred job name', required=False)
    parser_plot.add_argument('--email', type=str, help='Email for notification', required=False)

    subparsers_plot = parser_plot.add_subparsers()
    parsers_plot_raw = subparsers_plot.add_parser('raw', help='Plot raw files help')
    parsers_plot_raw.add_argument('align', type=str, help='Alignment file in maf format')
    parsers_plot_raw.add_argument('target', type=str, help='Target (or reference) in fasta or idx file')
    parsers_plot_raw.add_argument('query', type=str, help='Query file in fasta of idx format')
    parsers_plot_backup = subparsers_plot.add_parser('backup', help='plot backup help')
    parsers_plot_backup.add_argument('backup', type=str, help='Backup file in tar or tar.gz format')

    parser_batch = subparsers.add_parser('batch', help='batch help')
    parser_batch.add_argument('--name', type=str, help='Preferred job name', required=False)
    parser_batch.add_argument('--email', type=str, help='Email for notification', required=False)
    parser_batch.add_argument('batch_file', type=str, help='Batch file in txt format')
    parser_batch.add_argument('data_file', nargs='*', type=str, help='Data files used as input in batch file')

    return parser

def main():
    parser = get_argparse()
    args = parser.parse_args()
    print(args)
    config = get_config()
    if args.command == "config":
        config = get_config()
        print(config)
    elif args.command == "align":
        print(args.options)
        job = AlignJob(config, args)
        res = submit(job)
        print(res)
        update_status(res[0])
    elif args.command == "plot":
        job = PlotJob(config, args)
        #res = submit_job(job_data)
        res = submit(job)
        print(res)
        update_status(res[0])
    elif args.command == "batch":
        #res = submit_job(job_data)
        job = BatchJob(config, args)
        print(job.to_json())
        res = submit(job)
        print(res)
        update_status(res[0])
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
